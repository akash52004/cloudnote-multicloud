# PostgreSQL connection string. Use a managed PostgreSQL service reachable
# from BOTH Azure App Service and AWS App Runner.
DATABASE_URL=postgresql://cloudnote_user:change-me@your-postgres-host:5432/cloudnote?sslmode=require

# Set to azure in Azure App Service and aws in AWS App Runner.
CLOUD_PROVIDER=local

# Optional: set true only when your PostgreSQL provider requires TLS
PGSSL=false
